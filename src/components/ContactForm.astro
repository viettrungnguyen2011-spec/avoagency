---
import Icon from './Icon.astro';
import { useTranslations, contact, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Trang này là static nên không có server xử lý form.
// Endpoint được nhúng lúc build từ biến môi trường PUBLIC_FORM_ENDPOINT.
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';

// Access Key của Web3Forms. Key bắt buộc phải nằm trong HTML thì form mới chạy,
// nhưng để trong .env (đã gitignore) thì nó không bị đẩy lên repo GitHub.
const web3Key = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';

// Tiêu đề email nhận được, để phân biệt với thư rác trong hộp thư
const mailSubject =
  lang === 'vi'
    ? 'Yêu cầu tư vấn mới từ website AVO AGENCY'
    : 'New consultation request from the AVO AGENCY website';
---

<section class="section contact" id="contact">
  <div class="shell contact__inner">
    <div class="contact__aside">
      <p class="eyebrow" data-reveal-target>{t.form.eyebrow}</p>
      <h2 data-reveal-target data-reveal-delay="60">{t.form.title}</h2>
      <p class="lede" data-reveal-target data-reveal-delay="120">{t.form.lede}</p>

      <div class="contact__direct" data-reveal-target data-reveal-delay="180">
        <p class="contact__direct-label">{t.form.orDirect}</p>
        <ul class="contact__channels" role="list">
          <li>
            <a href={contact.hotlineHref}>
              <Icon name="phone" size={18} />
              <span>
                <span class="ch__k">Hotline</span>
                <span class="ch__v">{contact.hotline}</span>
              </span>
            </a>
          </li>
          <li>
            <a href={`mailto:${contact.email}`}>
              <Icon name="mail" size={18} />
              <span>
                <span class="ch__k">Email</span>
                <span class="ch__v">{contact.email}</span>
              </span>
            </a>
          </li>
          <li>
            <a href={contact.zaloHref} target="_blank" rel="noopener noreferrer">
              <Icon name="chat" size={18} />
              <span>
                <span class="ch__k">Zalo</span>
                <span class="ch__v">{contact.zaloName}</span>
              </span>
            </a>
          </li>
          <li>
            <a href={contact.tiktokHref} target="_blank" rel="noopener noreferrer">
              <Icon name="play" size={18} />
              <span>
                <span class="ch__k">TikTok</span>
                <span class="ch__v">{contact.tiktok}</span>
              </span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="contact__panel" data-reveal-target data-reveal-delay="120">
      <form class="form" data-form data-endpoint={endpoint} novalidate>
        <!-- Bẫy spam lớp 1: bot điền hết mọi ô, người thật không thấy ô này.
             Được kiểm ở phía trình duyệt trước khi gửi đi. -->
        <div class="form__trap" aria-hidden="true">
          <label for="company-website">Website</label>
          <input id="company-website" name="company_website" type="text" tabindex="-1" autocomplete="off" />
          <!-- Bẫy spam lớp 2: ô này do Web3Forms tự lọc ở phía máy chủ -->
          <input name="botcheck" type="checkbox" tabindex="-1" />
        </div>

        <!-- Các trường Web3Forms đọc, người dùng không nhìn thấy -->
        {web3Key && <input type="hidden" name="access_key" value={web3Key} />}
        <input type="hidden" name="subject" value={mailSubject} />
        <input type="hidden" name="from_name" value="AVO AGENCY Website" />

        <div class="form__row">
          <div class="field">
            <label for="f-name">
              {t.form.name} <span class="field__req">({t.form.required})</span>
            </label>
            <input
              id="f-name"
              name="name"
              type="text"
              autocomplete="name"
              placeholder={t.form.namePlaceholder}
              required
              aria-describedby="e-name"
            />
            <p class="field__err" id="e-name" data-err-for="name" hidden>{t.form.errName}</p>
          </div>

          <div class="field">
            <label for="f-shop">
              {t.form.shop} <span class="field__opt">({t.form.optional})</span>
            </label>
            <input
              id="f-shop"
              name="shop"
              type="text"
              autocomplete="organization"
              placeholder={t.form.shopPlaceholder}
            />
          </div>
        </div>

        <div class="form__row">
          <div class="field">
            <label for="f-email">
              {t.form.email} <span class="field__req">({t.form.required})</span>
            </label>
            <input
              id="f-email"
              name="email"
              type="email"
              inputmode="email"
              autocomplete="email"
              placeholder={t.form.emailPlaceholder}
              required
              aria-describedby="e-email"
            />
            <p class="field__err" id="e-email" data-err-for="email" hidden>{t.form.errEmail}</p>
          </div>

          <div class="field">
            <label for="f-phone">
              {t.form.phone} <span class="field__opt">({t.form.optional})</span>
            </label>
            <input
              id="f-phone"
              name="phone"
              type="tel"
              inputmode="tel"
              autocomplete="tel"
              placeholder={t.form.phonePlaceholder}
              aria-describedby="h-phone"
            />
            <p class="field__help" id="h-phone">{t.form.phoneHelp}</p>
          </div>
        </div>

        <div class="field">
          <label for="f-need">{t.form.need}</label>
          <div class="field__select">
            <select id="f-need" name="need">
              {t.form.needOptions.map((o) => <option value={o}>{o}</option>)}
            </select>
            <Icon name="arrow-right" size={16} class="field__caret" />
          </div>
        </div>

        <div class="field">
          <label for="f-message">
            {t.form.message} <span class="field__req">({t.form.required})</span>
          </label>
          <textarea
            id="f-message"
            name="message"
            rows="5"
            placeholder={t.form.messagePlaceholder}
            required
            aria-describedby="e-message"></textarea>
          <p class="field__err" id="e-message" data-err-for="message" hidden>{t.form.errMessage}</p>
        </div>

        <button class="btn btn--primary btn--lg form__submit" type="submit" data-submit>
          <span data-submit-label>{t.form.submit}</span>
          <Icon name="arrow-right" size={18} />
        </button>

        <!-- role=status: trình đọc màn hình tự thông báo khi nội dung đổi -->
        <p class="form__note" data-form-note role="status" aria-live="polite" hidden></p>
      </form>

      <div class="form__done" data-form-done hidden>
        <span class="form__done-icon" aria-hidden="true"><Icon name="check" size={26} /></span>
        <h3>{t.form.successTitle}</h3>
        <p>{t.form.successBody}</p>
      </div>
    </div>
  </div>
</section>

<script
  define:vars={{
    strings: {
      errName: t.form.errName,
      errEmail: t.form.errEmail,
      errMessage: t.form.errMessage,
      errSubmit: `${t.form.errSubmit} ${contact.hotline}.`,
      notConfigured: t.form.notConfigured,
      submit: t.form.submit,
      submitting: t.form.submitting,
    },
  }}
>
  const form = document.querySelector('[data-form]');
  if (form) {
    const note = form.querySelector('[data-form-note]');
    const btn = form.querySelector('[data-submit]');
    const btnLabel = form.querySelector('[data-submit-label]');
    const done = document.querySelector('[data-form-done]');
    const endpoint = form.dataset.endpoint;

    const showErr = (name, on) => {
      const el = form.querySelector(`[data-err-for="${name}"]`);
      const input = form.elements[name];
      if (el) el.hidden = !on;
      if (input) input.setAttribute('aria-invalid', on ? 'true' : 'false');
    };

    const validate = () => {
      const v = {
        name: form.elements.name.value.trim(),
        email: form.elements.email.value.trim(),
        message: form.elements.message.value.trim(),
      };
      const bad = {
        name: v.name.length < 2,
        // Kiểm tra tối thiểu: có ký tự, @, ký tự, dấu chấm, ký tự.
        // Cố tình không dùng regex RFC đầy đủ vì nó chặn nhầm email hợp lệ.
        email: !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.email),
        message: v.message.length < 10,
      };
      Object.keys(bad).forEach((k) => showErr(k, bad[k]));
      return { ok: !Object.values(bad).some(Boolean), bad };
    };

    // Xoá thông báo lỗi ngay khi người dùng bắt đầu sửa
    ['name', 'email', 'message'].forEach((n) => {
      form.elements[n].addEventListener('input', () => showErr(n, false));
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      note.hidden = true;

      const { ok, bad } = validate();
      if (!ok) {
        // Đưa focus về ô sai đầu tiên để người dùng bàn phím không phải mò
        const first = Object.keys(bad).find((k) => bad[k]);
        form.elements[first]?.focus();
        return;
      }

      // Bot điền vào bẫy -> giả vờ thành công, không gửi đi đâu cả
      if (form.elements.company_website.value) {
        form.hidden = true;
        done.hidden = false;
        return;
      }

      if (!endpoint) {
        note.hidden = false;
        note.dataset.tone = 'warn';
        note.textContent = strings.notConfigured;
        return;
      }

      btn.disabled = true;
      btnLabel.textContent = strings.submitting;

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.hidden = true;
        done.hidden = false;
        done.querySelector('h3')?.focus?.();
      } catch {
        note.hidden = false;
        note.dataset.tone = 'error';
        note.textContent = strings.errSubmit;
      } finally {
        btn.disabled = false;
        btnLabel.textContent = strings.submit;
      }
    });
  }
</script>

<style>
  .contact {
    background: var(--color-bg-sunken);
  }

  .contact__inner {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 56.25rem) {
    .contact__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      gap: var(--space-3xl);
      align-items: start;
    }
    .contact__aside {
      position: sticky;
      inset-block-start: calc(var(--header-h) + var(--space-lg));
    }
  }

  .contact__aside h2 {
    margin-block: var(--space-sm) var(--space-md);
  }

  .contact__direct {
    margin-block-start: var(--space-xl);
  }

  .contact__direct-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-fg-subtle);
    margin-block-end: var(--space-sm);
  }

  .contact__channels {
    display: grid;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
  }

  .contact__channels a {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--space-sm);
    min-block-size: 3.25rem;
    padding: var(--space-2xs) var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    text-decoration: none;
    transition:
      border-color var(--dur-base) var(--ease-out),
      background-color var(--dur-base) var(--ease-out);
  }

  .contact__channels a:hover {
    border-color: var(--a-gold-32);
    background: var(--color-surface-raised);
  }

  .contact__channels :global(svg) {
    color: var(--color-accent);
  }

  .ch__k {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-fg-subtle);
  }

  .ch__v {
    display: block;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-fg);
  }

  /* ---------- Bảng form ---------- */
  .contact__panel {
    padding: clamp(1.25rem, 0.8rem + 2vw, 2.25rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
  }

  .form {
    display: grid;
    gap: var(--space-md);
  }

  .form__trap {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .form__row {
    display: grid;
    gap: var(--space-md);
  }

  @media (min-width: 32rem) {
    .form__row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .field {
    display: grid;
    gap: var(--space-3xs);
  }

  .field label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-fg);
  }

  .field__req,
  .field__opt {
    font-weight: 400;
    color: var(--color-fg-subtle);
  }

  .field input,
  .field textarea,
  .field select {
    inline-size: 100%;
    /* 48px cao: thoải mái cho ngón tay, vượt ngưỡng 44px */
    min-block-size: 3rem;
    padding: var(--space-2xs) var(--space-sm);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg-sunken);
    color: var(--color-fg);
    font-size: var(--text-base);
    transition:
      border-color var(--dur-base) var(--ease-out),
      background-color var(--dur-base) var(--ease-out);
  }

  .field textarea {
    min-block-size: 8rem;
    padding-block: var(--space-2xs);
    resize: vertical;
    line-height: var(--leading-normal);
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--color-fg-subtle);
    opacity: 1;
  }

  .field input:hover,
  .field textarea:hover,
  .field select:hover {
    border-color: var(--a-gold-32);
  }

  .field input:focus,
  .field textarea:focus,
  .field select:focus {
    background: var(--color-bg);
  }

  .field input[aria-invalid='true'],
  .field textarea[aria-invalid='true'] {
    border-color: var(--color-danger);
  }

  .field__select {
    position: relative;
    display: grid;
  }

  .field__select select {
    appearance: none;
    padding-inline-end: var(--space-xl);
    cursor: pointer;
  }

  .field__select :global(.field__caret) {
    position: absolute;
    inset-inline-end: var(--space-sm);
    inset-block-start: 50%;
    translate: 0 -50%;
    rotate: 90deg;
    pointer-events: none;
    color: var(--color-fg-subtle);
  }

  /* Trình đơn thả xuống của hệ điều hành dùng màu nền riêng — ép về tối */
  .field__select option {
    background: var(--navy-800);
    color: var(--color-fg);
  }

  .field__help {
    font-size: var(--text-xs);
    color: var(--color-fg-subtle);
  }

  /* Lỗi hiện NGAY DƯỚI ô sai, không gom lên đầu form */
  .field__err {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-danger);
  }

  .form__submit {
    inline-size: 100%;
    margin-block-start: var(--space-2xs);
  }

  .form__submit:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .form__note {
    padding: var(--space-2xs) var(--space-sm);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
  }

  .form__note[data-tone='error'] {
    background: rgb(255 90 95 / 0.12);
    color: #ffb4b6;
  }

  .form__note[data-tone='warn'] {
    background: var(--a-gold-08);
    color: var(--gold-300);
  }

  /* ---------- Trạng thái gửi thành công ---------- */
  .form__done {
    display: grid;
    justify-items: center;
    gap: var(--space-2xs);
    padding-block: var(--space-xl);
    text-align: center;
  }

  .form__done-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 3.5rem;
    block-size: 3.5rem;
    margin-block-end: var(--space-2xs);
    border-radius: var(--radius-full);
    background: rgb(46 204 143 / 0.14);
    color: var(--color-positive);
  }

  .form__done h3 {
    font-size: var(--text-xl);
  }

  .form__done p {
    max-inline-size: 34ch;
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
  }
</style>
