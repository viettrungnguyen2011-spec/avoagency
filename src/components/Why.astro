---
import Icon from './Icon.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="section why" id="why">
  <div class="shell">
    <header class="why__head">
      <p class="eyebrow" data-reveal-target>{t.why.eyebrow}</p>
      <h2 data-reveal-target data-reveal-delay="60">{t.why.title}</h2>
      <p class="lede" data-reveal-target data-reveal-delay="120">{t.why.lede}</p>
    </header>

    <ul class="why__grid" role="list">
      {
        t.why.items.map((item) => (
          <li
            class:list={['wcard', { 'wcard--hl': 'highlight' in item && item.highlight }]}
            data-reveal-target
          >
            <span class="wcard__num" aria-hidden="true">
              {item.num}
            </span>
            <div class="wcard__body">
              <h3 class="wcard__name">{item.name}</h3>
              <ul class="wcard__points" role="list">
                {item.points.map((p) => (
                  <li>
                    <Icon name="check" size={15} />
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .why {
    background: var(--color-bg);
  }

  .why__head {
    max-inline-size: 46rem;
    margin-block-end: var(--space-2xl);
  }

  .why__head h2 {
    margin-block: var(--space-sm) var(--space-md);
  }

  .why__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
  }

  .wcard {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-md);
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    transition: border-color var(--dur-base) var(--ease-out);
  }

  .wcard:hover {
    border-color: var(--color-border-strong);
  }

  /* "Làm xong mới thanh toán" là lời hứa mạnh nhất — kéo mắt về đây */
  .wcard--hl {
    border-color: var(--a-gold-32);
    background:
      linear-gradient(135deg, var(--a-gold-08), transparent 60%),
      var(--color-surface-raised);
    box-shadow: var(--shadow-gold);
  }

  .wcard__num {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    color: var(--color-fg-subtle);
    padding-block-start: 0.2em;
  }

  .wcard--hl .wcard__num {
    color: var(--color-accent);
  }

  .wcard__name {
    margin-block-end: var(--space-sm);
    font-size: var(--text-lg);
    font-weight: 800;
  }

  .wcard--hl .wcard__name {
    color: var(--color-accent);
  }

  .wcard__points {
    display: grid;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wcard__points li {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: var(--space-2xs);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-fg-muted);
  }

  .wcard__points :global(svg) {
    margin-block-start: 0.28em;
    color: var(--color-positive);
  }

  .wcard--hl .wcard__points :global(svg) {
    color: var(--color-accent);
  }
</style>
