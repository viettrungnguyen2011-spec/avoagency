# Sao chép file này thành `.env` rồi điền giá trị thật.
# File `.env` đã được .gitignore — không bao giờ push lên GitHub.

# Domain thật, dùng cho canonical URL + Open Graph + sitemap
PUBLIC_SITE_URL=https://avo.com.vn

# Endpoint nhận form báo giá.
# Trang này là static nên không có server để xử lý form — phải dùng dịch vụ ngoài.
# Xem hướng dẫn trong README.md, mục "Kết nối form".
PUBLIC_FORM_ENDPOINT=https://api.web3forms.com/submit

# Access Key lấy ở web3forms.com (nhập email, bấm Create Access Key).
PUBLIC_WEB3FORMS_KEY=
