# ============================================================================
# AVO AGENCY — cấu hình Apache cho Hostinger shared hosting
#
# File này được copy nguyên vẹn vào dist/ khi build, rồi upload lên public_html.
# Nếu upload xong mà trang lỗi 500, hãy đổi tên file này thành .htaccess.bak
# rồi báo lại — nghĩa là gói hosting của bạn tắt một module nào đó bên dưới.
# ============================================================================

# ---------------------------------------------------------------------------
# 1. Ép HTTPS
# Hostinger cấp SSL miễn phí. Bật xong thì bắt buộc chuyển hết sang https.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Bỏ "index.html" ở cuối URL cho gọn (/en/index.html -> /en/)
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /%1 [R=301,L]

  # --- Chọn MỘT trong hai khối dưới đây, bỏ dấu # ở đầu dòng ---
  # Nếu muốn domain KHÔNG có www (khuyến nghị):
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Nếu muốn domain CÓ www:
  # RewriteCond %{HTTP_HOST} !^www\. [NC]
  # RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# ---------------------------------------------------------------------------
# 2. Nén — giảm khoảng 70% dung lượng HTML/CSS/JS truyền đi
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE text/javascript application/javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE application/rss+xml image/svg+xml
  # KHÔNG nén woff2 và ảnh: chúng đã được nén sẵn, nén lại chỉ tốn CPU
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
  AddOutputFilterByType BROTLI_COMPRESS text/javascript application/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# 3. Cache trình duyệt
# Tên file CSS/JS do Astro sinh ra có mã băm, nên cache 1 năm là an toàn:
# nội dung đổi thì tên file cũng đổi theo.
# HTML thì KHÔNG cache lâu, nếu không người dùng sẽ thấy bản cũ sau khi bạn
# cập nhật website.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  ExpiresByType text/html                     "access plus 0 seconds"
  ExpiresByType text/css                      "access plus 1 year"
  ExpiresByType application/javascript        "access plus 1 year"
  ExpiresByType text/javascript               "access plus 1 year"
  ExpiresByType font/woff2                    "access plus 1 year"
  ExpiresByType image/png                     "access plus 6 months"
  ExpiresByType image/jpeg                    "access plus 6 months"
  ExpiresByType image/webp                    "access plus 6 months"
  ExpiresByType image/svg+xml                 "access plus 6 months"
  ExpiresByType image/x-icon                  "access plus 6 months"
  ExpiresByType application/xml               "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # -------------------------------------------------------------------------
  # 4. Header bảo mật
  # -------------------------------------------------------------------------
  # Chặn nhúng site vào iframe của bên khác (chống clickjacking)
  Header always set X-Frame-Options "SAMEORIGIN"
  # Chặn trình duyệt tự đoán kiểu file
  Header always set X-Content-Type-Options "nosniff"
  # Không gửi đường dẫn đầy đủ sang site khác
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Tắt các quyền trang này không dùng
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"

  # CSP: toàn bộ tài nguyên nằm cùng domain (font đã self-host).
  # 'unsafe-inline' cho style là bắt buộc vì Astro nội tuyến CSS quan trọng.
  # Nếu sau này bạn gắn Google Analytics hay Meta Pixel, phải thêm domain của
  # chúng vào script-src và connect-src, nếu không trình duyệt sẽ chặn.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self' https://formspree.io https://api.web3forms.com; form-action 'self' https://formspree.io https://api.web3forms.com; frame-ancestors 'self'; base-uri 'self'"

  # Gỡ header lộ phiên bản phần mềm máy chủ
  Header unset X-Powered-By
</IfModule>

# ---------------------------------------------------------------------------
# 5. Trang 404
# ---------------------------------------------------------------------------
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# 6. Chặn truy cập file nhạy cảm
# ---------------------------------------------------------------------------
<FilesMatch "^\.(env|git|gitignore)|\.(json|md|log|bak)$">
  Require all denied
</FilesMatch>

# Cho phép lại các file cần thiết bị khối trên chặn nhầm
<Files "site.webmanifest">
  Require all granted
</Files>

# Tắt liệt kê thư mục
Options -Indexes

# Bảng mã mặc định — thiếu dòng này chữ tiếng Việt có thể hiện thành ký tự lạ
AddDefaultCharset UTF-8
